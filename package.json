{
  "name": "hive-buzz",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "sidecar:build": "cd sidecar && bun run build",
    "sidecar:test": "cd sidecar && bun run test",
    "overlays:test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p overlays/tsconfig.json && cd sidecar && bun run typecheck",
    "test": "bun run sidecar:test && bun run overlays:test && cargo test --manifest-path src-tauri/Cargo.toml",
    "app:dev": "bun scripts/with-env.mjs tauri dev",
    "app:build": "bun scripts/with-env.mjs tauri build",
    "app:check": "bun scripts/with-env.mjs --check"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2",
    "i18next": "^26.4.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.3"
  }
}
