# Copia este archivo a `.env` (`copy .env.example .env`) y rellénalo.
# `.env` está en .gitignore: NUNCA lo subas a Git.
# Se usa con:  bun run app:dev   (desarrollo)   y   bun run app:build   (instalador)

# --- Spotify (opcional) ---------------------------------------------------------------------------
# Client ID integrado de TU app en https://developer.spotify.com/dashboard  (es público; no es un secreto).
# En esa app añade el Redirect URI:  http://127.0.0.1:17890/spotify/callback
# Ojo: una app en modo desarrollo solo funciona para las cuentas que añadas en «User Management».
# Sin esto, cada streamer configura su propia app desde Integraciones → Spotify.
HIVEBUZZ_SPOTIFY_CLIENT_ID=

# --- Twitch (inicio de sesión opcional: seguidores, estado del directo y espectadores) ----------
# Client ID de TU app de Twitch en https://dev.twitch.tv/console  (tipo de cliente: «Público»; es público, no un secreto).
# No hace falta redirect URI: se usa el inicio de sesión con código en pantalla (twitch.tv/activate).
# Sin esto, leer el chat de Twitch funciona igual; solo falta el botón «Entrar con Twitch».
HIVEBUZZ_TWITCH_CLIENT_ID=

# --- Firma de actualizaciones (solo si publicas releases con auto-update) ------------------------
# Genera la clave una vez:  bunx tauri signer generate -w %USERPROFILE%\.tauri\hivebuzz.key
# La clave PÚBLICA va en src-tauri/tauri.conf.json -> plugins.updater.pubkey
# La PRIVADA nunca se copia al repo: aquí solo se indica dónde está.
TAURI_SIGNING_PRIVATE_KEY_PATH=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
